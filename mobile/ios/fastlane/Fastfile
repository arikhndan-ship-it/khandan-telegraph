default_platform(:ios)

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["ASC_KEY_PATH"])
    )
  end

  desc "Setup code signing (cert + App ID + profile)"
  lane :setup_signing do
    # Create Distribution Certificate
    cert(development: false, output_path: "/tmp/certs")

    # Create App ID on Developer Portal
    begin
      produce(
        app_identifier: "com.khandan.telegraph",
        app_name: "Khandan",
        skip_itc: true
      )
    rescue => e
      puts "App ID note: #{e.message}"
    end

    # Download App Store Distribution Provisioning Profile
    sigh(
      app_identifier: "com.khandan.telegraph",
      force: true,
      adhoc: false,
      development: false
    )
  end
end
